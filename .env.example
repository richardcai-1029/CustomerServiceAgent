# --- LLM provider: "qwen" (DashScope) or "deepseek" ---
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=sk-...
# Only needed when LLM_PROVIDER=deepseek (embeddings still use DashScope).
DEEPSEEK_API_KEY=
# Optional overrides; defaults: qwen-plus / qwen-flash (or deepseek-chat).
CHAT_MODEL=
EMOTION_MODEL=

RERANK_ENABLED=true
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/cs_agent

# Dev mode prints a fixed SMS code (123456). Set false + a real secret in production.
DEV_MODE=true
JWT_SECRET=dev-only-secret-change-me-in-production-0000

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cs-agent
